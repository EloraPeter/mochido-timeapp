# ==========================================
# Supabase — Phase 1 (Course Materials)
# ==========================================
# Get these from: https://supabase.com/dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ==========================================
# Cron job protection (optional but recommended)
# ==========================================
# Set this to any random string, then send it as:
#   Authorization: Bearer YOUR_SECRET
# in your cron scheduler's request headers.
# If left empty, the keep-alive endpoint accepts all requests.
CRON_SECRET=

# ==========================================
# Google OAuth — Phase 1 only (existing)
# ==========================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
